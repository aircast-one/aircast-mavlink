{
  "name": "@aircast-one/mavlink",
  "version": "3.0.0",
  "description": "TypeScript type generator for MAVLink dialects",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/core/types.d.ts"
    },
    "./common": {
      "types": "./dist/dialects/common/full.d.ts",
      "import": "./dist/dialects/common/full.js"
    },
    "./common/parser": {
      "types": "./dist/dialects/common/parser.d.ts",
      "import": "./dist/dialects/common/parser.js"
    },
    "./common/messages": {
      "types": "./dist/dialects/common/messages.d.ts",
      "import": "./dist/dialects/common/messages.js"
    },
    "./common/constants/*": {
      "types": "./dist/dialects/common/constants/*.d.ts",
      "import": "./dist/dialects/common/constants/*.js"
    },
    "./minimal": {
      "types": "./dist/dialects/minimal/full.d.ts",
      "import": "./dist/dialects/minimal/full.js"
    },
    "./minimal/parser": {
      "types": "./dist/dialects/minimal/parser.d.ts",
      "import": "./dist/dialects/minimal/parser.js"
    },
    "./minimal/messages": {
      "types": "./dist/dialects/minimal/messages.d.ts",
      "import": "./dist/dialects/minimal/messages.js"
    },
    "./minimal/constants/*": {
      "types": "./dist/dialects/minimal/constants/*.d.ts",
      "import": "./dist/dialects/minimal/constants/*.js"
    },
    "./ardupilotmega": {
      "types": "./dist/dialects/ardupilotmega/full.d.ts",
      "import": "./dist/dialects/ardupilotmega/full.js"
    },
    "./ardupilotmega/parser": {
      "types": "./dist/dialects/ardupilotmega/parser.d.ts",
      "import": "./dist/dialects/ardupilotmega/parser.js"
    },
    "./ardupilotmega/messages": {
      "types": "./dist/dialects/ardupilotmega/messages.d.ts",
      "import": "./dist/dialects/ardupilotmega/messages.js"
    },
    "./ardupilotmega/constants/*": {
      "types": "./dist/dialects/ardupilotmega/constants/*.d.ts",
      "import": "./dist/dialects/ardupilotmega/constants/*.js"
    },
    "./standard": {
      "types": "./dist/dialects/standard/full.d.ts",
      "import": "./dist/dialects/standard/full.js"
    },
    "./standard/parser": {
      "types": "./dist/dialects/standard/parser.d.ts",
      "import": "./dist/dialects/standard/parser.js"
    },
    "./standard/messages": {
      "types": "./dist/dialects/standard/messages.d.ts",
      "import": "./dist/dialects/standard/messages.js"
    },
    "./standard/constants/*": {
      "types": "./dist/dialects/standard/constants/*.d.ts",
      "import": "./dist/dialects/standard/constants/*.js"
    }
  },
  "sideEffects": [
    "./dist/dialects/*/full.js"
  ],
  "mavlinkCommit": "6dac9679ded48f96a44aab4c56958755b1d8638a",
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run generate && npm run build:bundle",
    "build:bundle": "rollup -c && tsc --declaration --emitDeclarationOnly --outDir dist --rootDir src --target ES2020 --moduleResolution node --esModuleInterop --resolveJsonModule --skipLibCheck src/core/types.ts src/core/crc.ts src/core/codec.ts src/core/frame.ts src/core/parser.ts src/core/stream-buffer.ts src/core/message-registry.ts src/core/message-serializer.ts src/core/index.ts",
    "generate": "npm run gen:all",
    "start": "node dist/cli.js",
    "dev": "bun src/cli.ts",
    "test": "jest",
    "test:coverage": "jest --coverage --collectCoverageFrom=\"src/**/*.ts\" --collectCoverageFrom=\"!src/generated/**/*\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "clean": "rm -rf dist src/generated",
    "gen:url": "echo https://raw.githubusercontent.com/mavlink/mavlink/$(node -p \"require('./package.json').mavlinkCommit\")/message_definitions/v1.0",
    "gen:common": "bun src/cli.ts generate -i $(npm run --silent gen:url)/common.xml -o ./src/generated/dialects/common",
    "gen:ardupilotmega": "bun src/cli.ts generate -i $(npm run --silent gen:url)/ardupilotmega.xml -o ./src/generated/dialects/ardupilotmega",
    "gen:minimal": "bun src/cli.ts generate -i $(npm run --silent gen:url)/minimal.xml -o ./src/generated/dialects/minimal",
    "gen:test": "bun src/cli.ts generate -i $(npm run --silent gen:url)/test.xml -o ./src/generated/dialects/test",
    "gen:paparazzi": "bun src/cli.ts generate -i $(npm run --silent gen:url)/paparazzi.xml -o ./src/generated/dialects/paparazzi",
    "gen:python_array_test": "bun src/cli.ts generate -i $(npm run --silent gen:url)/python_array_test.xml -o ./src/generated/dialects/python_array_test",
    "gen:standard": "bun src/cli.ts generate -i $(npm run --silent gen:url)/standard.xml -o ./src/generated/dialects/standard",
    "gen:all": "npm run gen:common && npm run gen:ardupilotmega && npm run gen:minimal && npm run gen:standard",
    "release:patch": "npm version patch && git push origin master --tags && gh release create v$(node -p \"require('./package.json').version\") --title \"v$(node -p \"require('./package.json').version\")\" --generate-notes",
    "release:minor": "npm version minor && git push origin master --tags && gh release create v$(node -p \"require('./package.json').version\") --title \"v$(node -p \"require('./package.json').version\")\" --generate-notes",
    "release:major": "npm version major && git push origin master --tags && gh release create v$(node -p \"require('./package.json').version\") --title \"v$(node -p \"require('./package.json').version\")\" --generate-notes",
    "prepare": "lefthook install"
  },
  "keywords": [
    "aircast",
    "mavlink",
    "typescript",
    "code-generation",
    "drone",
    "autopilot"
  ],
  "author": "Aircast MAVLink",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavliha/aircast-mavlink.git"
  },
  "bugs": {
    "url": "https://github.com/pavliha/aircast-mavlink/issues"
  },
  "homepage": "https://github.com/pavliha/aircast-mavlink#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.7",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "commander": "^11.1.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "jest": "^29.7.0",
    "lefthook": "^2.0.13",
    "node-mavlink": "^2.1.0",
    "prettier": "^3.6.2",
    "rollup": "^4.9.6",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "^29.4.0",
    "tslib": "^2.6.2",
    "typescript": "5.3.3",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aircast-one/mavlink": "^3.0.0"
  }
}
